ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
BUILD_DIR="$ROOT_DIR/build"

if [ "${1:-}" = "--clean" ]; then
    rm -rf "$BUILD_DIR"
    echo "Build directory cleaned."
fi

mkdir -p "$BUILD_DIR"
echo "Running cmake (source: $ROOT_DIR, build: $BUILD_DIR)."
cmake -S "$ROOT_DIR" -B "$BUILD_DIR"
echo "Building..."
cmake --build "$BUILD_DIR" -- -j$(nproc)
